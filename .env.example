# DigitalOcean model access key (Control Panel > Inference > Model Access Keys)
DIGITALOCEAN_ACCESS_TOKEN=
# Your fork of socialify (owner/name). Issues, code and draft PRs all live here.
TARGET_REPO=your-github-user/socialify
# Filled in by `pnpm board:setup`.
PROJECT_OWNER=
PROJECT_NUMBER=
# How often `pnpm factory` checks the board, in ms.
BOARD_POLL_MS=5000
# Per-attempt limit for the maintainer, in ms. A hung model counts as a failed attempt.
MAINTAINER_TIMEOUT_MS=480000
